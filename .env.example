# The app talks ONLY to Spring Boot. Backend base URL by target:
#   Android emulator:  http://10.0.2.2:8085
#   USB (adb reverse tcp:8085 tcp:8085):  http://127.0.0.1:8085
#   Physical device / Wi-Fi:  http://<your-lan-ip>:8085
#   Production:  https://api.example.com  (HTTPS)
EXPO_PUBLIC_GEOAPIFY_API_KEY=
EXPO_PUBLIC_BACKEND_BASE_URL=http://10.0.2.2:8085
# Demo mode serves canned offline data (devices, playback, live simulation, AI)
# for local manual testing without a backend. DEV-ONLY: it is force-disabled in
# production/release builds (gated behind __DEV__), so it can never leak into a
# shipped app even if left true. Set true + run the dev server to use it.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_RAZORPAY_ENABLED=false
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
